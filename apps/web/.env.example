# =============================================================================
# Shipyard Web (apps/web) 環境変数
# =============================================================================
#
# このファイルは Git にコミットされます(値は入れない)。
# 実際の値は `apps/web/.env.local` にコピーして設定してください。
# .env.local は .gitignore で除外されています。
#
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk(認証)
# -----------------------------------------------------------------------------
# 取得方法:
#   1. https://clerk.com にサインアップ
#   2. Application を作成し、Dashboard の "API keys" から取得
#
# Publishable key はクライアント(ブラウザ)側に公開される。
# NEXT_PUBLIC_ プレフィックスは Next.js が公開を許可する印。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key はサーバー側のみで使用。漏洩厳禁。
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk のリダイレクト先(任意)
# fallback は中間ページ /sign-in-complete に向ける。email サインイン後にクライアント遷移で `/` へ
# 飛ぶと、`/` のサーバ redirect が追従されず白紙になるため、フルロード遷移を挟んで回避する
# (apps/web/src/app/sign-in-complete/page.tsx 参照)。変更後は dev サーバ再起動が必要。
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/sign-in-complete
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-in-complete

# -----------------------------------------------------------------------------
# API(apps/api / NestJS)
# -----------------------------------------------------------------------------
# Server Component / Route Handler から apps/api を呼ぶときのベース URL。
# サーバー側でのみ使うので NEXT_PUBLIC_ プレフィックスは付けない。
# ローカル: http://localhost:4000、本番: App Runner のカスタムドメイン(https://api.<domain>)
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# サイト URL(OG 画像・メタデータの絶対 URL 解決)
# -----------------------------------------------------------------------------
# OG 画像やメタデータの canonical URL を絶対 URL に解決するためのベース URL
# (metadataBase)。サーバー側でのみ使うので NEXT_PUBLIC_ プレフィックスは付けない。
# 未設定時は Vercel 本番 URL(VERCEL_PROJECT_PRODUCTION_URL)→ localhost の順で
# フォールバックする。本番ドメイン確定後(Day 37)に設定する。
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# アクセス解析(Google Analytics 4 / Microsoft Clarity)
# -----------------------------------------------------------------------------
# **本番(Vercel Production)でのみ計測する。** ローカルと Preview デプロイでは計測タグ自体が
# 描画されず、値を入れても送信は発生しない(apps/web/src/lib/analytics-env.ts)。
# したがってローカルでは未設定でよい。設定するのは Vercel(Production)側。
#
# GA4 測定 ID。取得: https://analytics.google.com → 管理 → データストリーム →
# ウェブストリームの「測定 ID」(G- で始まる)。
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity のプロジェクト ID。取得: https://clarity.microsoft.com →
# Settings → Setup → インストールコード内の 10 文字程度の ID。
NEXT_PUBLIC_CLARITY_PROJECT_ID=
